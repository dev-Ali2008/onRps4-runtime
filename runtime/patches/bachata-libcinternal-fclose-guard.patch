 // Since the file struct is exposed to the application, accuracy is important.
 static constexpr s32 g_initial_files = 5;
 static constexpr s32 g_max_files = 0x100;
+
+// True only when the FILE object was allocated by this HLE (via internal__Fofind).
+// Games may hand us FILE objects owned by a real sce_module libc; freeing those
+// on the host heap aborts with "munmap_chunk(): invalid pointer".
+static bool IsManagedFile(OrbisFILE* file) {
+    if (file == nullptr || file->_Idx < 0 || file->_Idx >= g_max_files) {
+        return false;
+    }
+    const auto it = g_files.find(file->_Idx);
+    return it != g_files.end() && it->second == file;
+}
 
